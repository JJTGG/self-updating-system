{
  "schedule_cron": "*/30 * * * *",
  "source": {
    "url_env": "DATA_SOURCE_URL",
    "timeout_seconds": 30
  },
  "output": {
    "dir": "data",
    "latest": "data/latest.json",
    "snapshots": "data/snapshots"
  },
  "validation": {
    "required_fields": [
      "full_name",
      "html_url"
    ],
    "max_response_bytes": 10485760
  },
  "repair": {
    "enabled": true,
    "auto_issue": true,
    "auto_pr": true,
    "max_attempts_per_day": 3
  },
  "changelog": "CHANGELOG.md"
}